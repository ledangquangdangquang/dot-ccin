@import "catppuccin-mocha"

* {
    font: "FiraCode Nerd Font Mono 14";
}

configuration {
    modi: "drun,ssh,run";
    display-drun: ">";
    display-ssh: "ssh";
    display-run: "run:";
    show-icons: true;
    icon-theme: "Papirus";
    terminal: "foot";
    drun-display-format: "{name}";
    sort: true;
    case-sensitive: false;
    scrolling-mode: 3;
    sidebar-mode: false;
}
