set $rosewater #f5e0dc
set $flamingo #f2cdcd
set $pink #f5c2e7
set $mauve #cba6f7
set $red #f38ba8
set $maroon #eba0ac
set $peach #fab387
set $yellow #f9e2af
set $green #a6e3a1
set $teal #94e2d5
set $sky #89dceb
set $sapphire #74c7ec
set $blue #89b4fa
set $lavender #b4befe
set $text #cdd6f4
set $subtext1 #bac2de
set $subtext0 #a6adc8
set $overlay2 #9399b2
set $overlay1 #7f849c
set $overlay0 #6c7086
set $surface2 #585b70
set $surface1 #45475a
set $surface0 #313244
set $base #1e1e2e
set $mantle #181825
set $crust #11111b

# Set your mod key to the Super (Windows) key
set $mod Mod4

# Startup applications
exec fcitx5 -d
exec dunst
exec clipboard-watcher
exec autotiling
exec --no-startup-id pactl set-default-sink alsa_output.pci-0000_00_1f.3-platform-skl_hda_dsp_generic.HiFi__hw_sofhdadsp__sink
exec --no-startup-id xrandr --output eDP-1 --off --output HDMI-1-0 --auto

# Basic keybindings
# Launch kitty terminal
bindsym $mod+Return exec kitty
# Launch Nautilus file manager
bindsym $mod+e exec nautilus --new-window
# Launch Firefox
bindsym $mod+Shift+f exec firefox
# Zathura for documentation
bindsym $mod+Shift+z exec zathura
# Close focused window
bindsym $mod+q kill
# Power menu
bindsym $mod+x exec power-menu
# Launch menu (fuzzel on Wayland, rofi on X11)
bindsym $mod+space exec menu-launcher
# Network menus
bindsym $mod+w exec wifi-menu
bindsym $mod+Ctrl+b exec bluetooth-menu
# Clipboard history
bindsym $mod+v exec clipboard-menu
bindsym $mod+Shift+v exec clipboard-clear
# Reload i3 config
bindsym $mod+Shift+r reload
# Key shortcut reference
bindsym $mod+i exec ~/.config/i3/show-keyshortcuts.sh
# Notifications
bindsym $mod+n exec dunstctl toggle
bindsym $mod+Shift+n exec dunstctl close-all
# Screenshots
bindsym F8 exec screenshot region
bindsym Shift+F8 exec screenshot full
bindsym Ctrl+F8 exec screenshot copy
# Toggle 4000K night light
bindsym F9 exec system-control night-light

exec --no-startup-id feh --bg-fill --no-fehbg ~/UbuntuConfig/Wallpapers/catppuccin-abstract-eclipse-1920x1080.png

# Move focus between windows
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# Move window instead of just focusing
bindsym $mod+Shift+h move left
bindsym $mod+Shift+l move right
bindsym $mod+Shift+k move up
bindsym $mod+Shift+j move down

# resise window
bindsym $mod+Ctrl+h resize shrink width 10px
bindsym $mod+Ctrl+l resize grow width 10px
bindsym $mod+Ctrl+k resize grow height 10px
bindsym $mod+Ctrl+j resize shrink height 10px

# Layout preset: master 70% / stack 30%
bindsym $mod+Backslash resize set width 70 ppt

# Brightness
# Increase brightness
bindsym XF86MonBrightnessUp exec system-control brightness-up
# Decrease brightness
bindsym XF86MonBrightnessDown exec system-control brightness-down
# Volume
bindsym XF86AudioRaiseVolume exec system-control volume-up
bindsym XF86AudioLowerVolume exec system-control volume-down
bindsym XF86AudioMute exec system-control volume-mute
# Function-key media controls
bindsym F1 exec system-control volume-mute
bindsym F2 exec system-control volume-down
bindsym F3 exec system-control volume-up
bindsym F6 exec system-control brightness-down
bindsym F7 exec system-control brightness-up
# Caps Lock status
bindsym --release Caps_Lock exec system-control caps-lock

# Workspace
# Open it while starting up
exec --no-startup-id i3-msg workspace 1
for_window [title="^.*"] title_format ""
default_border none
bar {
  position top
  height 28
  mode hide
  font pango:FiraCode Nerd Font 15
  status_command i3status-rs ~/.config/i3status-rust/config.toml

  colors {
    background         $base
    statusline         $text

    # target           border bg        text
    focused_workspace  $base  $mauve    $crust
    active_workspace   $base  $surface2 $text
    inactive_workspace $base  $base     $text
    urgent_workspace   $base  $red      $crust
  }
}

bindsym $mod+Shift+t bar mode toggle
# Workspaces define
# any
bindsym $mod+a workspace A
# setting
bindsym $mod+s workspace S
# documents
bindsym $mod+d workspace D
# coding
bindsym $mod+c workspace C
# browser
bindsym $mod+b workspace B

bindsym $mod+1 workspace 1
bindsym $mod+2 workspace 2
bindsym $mod+3 workspace 3
bindsym $mod+4 workspace 4
bindsym $mod+5 workspace 5

# Workspaces moving
bindsym $mod+Shift+a move container to workspace A
bindsym $mod+Shift+s move container to workspace S
bindsym $mod+Shift+d move container to workspace D
bindsym $mod+Shift+c move container to workspace C
bindsym $mod+Shift+b move container to workspace B
bindsym $mod+Shift+1 move container to workspace 1
bindsym $mod+Shift+2 move container to workspace 2
bindsym $mod+Shift+3 move container to workspace 3
bindsym $mod+Shift+4 move container to workspace 4
bindsym $mod+Shift+5 move container to workspace 5
# Which app is assigned to which workspace
assign [class="firefox"] workspace B
assign [class="zathura"] workspace D
assign [class="kitty"] workspace 1
for_window [class="firefox"] workspace B
for_window [class="zathura"] workspace D
for_window [class="kitty"] workspace 1
