set $rosewater #f5e0dc
set $flamingo #f2cdcd
set $pink #f5c2e7
set $mauve #cba6f7
set $red #f38ba8
set $maroon #eba0ac
set $peach #fab387
set $yellow #f9e2af
set $green #a6e3a1
set $teal #94e2d5
set $sky #89dceb
set $sapphire #74c7ec
set $blue #89b4fa
set $lavender #b4befe
set $text #cdd6f4
set $subtext1 #bac2de
set $subtext0 #a6adc8
set $overlay2 #9399b2
set $overlay1 #7f849c
set $overlay0 #6c7086
set $surface2 #585b70
set $surface1 #45475a
set $surface0 #313244
set $base #1e1e2e
set $mantle #181825
set $crust #11111b

# Set your mod key to the Super (Windows) key
set $mod Mod4

# Startup applications
# D-Bus-activated apps (Thunar via FileManager1) otherwise lack ~/.nix-profile/bin, so archive actions can't find xarchiver
exec --no-startup-id dbus-update-activation-environment --systemd PATH
exec --no-startup-id fcitx5 -d
exec --no-startup-id alacritty
exec --no-startup-id picom --config ~/.config/picom/picom.conf
exec --no-startup-id clipboard-watcher
# Wi-Fi/Bluetooth: on-demand TUIs (Mod+w / Mod+Shift+w) instead of tray applets (~500 MB idle)
# exec --no-startup-id nm-applet
# exec --no-startup-id blueman-applet
exec --no-startup-id udiskie --tray
exec --no-startup-id usb-notify
exec --no-startup-id audio-notify
exec --no-startup-id env SOUND_NAME=service-login notification-sound
exec_always --no-startup-id sh -c "pkill -f '^[^ ]*python3 [^ ]*auto-split-7030' || true && exec ~/.nix-profile/bin/python3 ~/.config/i3/auto-split-7030.py >/tmp/i3_autosplit_err.log 2>&1"
# Host-specific monitor layout, generated from hostMain in flake.nix (modules/display.nix)
font pango:FiraCode Nerd Font 10
include ~/.config/i3/host.conf
exec --no-startup-id xset dpms 0 0 0
# Screensaver: lock after 1 hour idle and before suspend.
# lock-screen (modules/lock.nix) wraps Ubuntu's /usr/bin/i3lock (system PAM).
exec --no-startup-id xset s 3600 3600
exec --no-startup-id xss-lock --transfer-sleep-lock -- lock-screen
bindsym $mod+Escape exec --no-startup-id loginctl lock-session

# Basic keybindings
# Launch alacritty terminal
bindsym $mod+Return exec --no-startup-id alacritty
# Launch Nautilus file manager
# bindsym $mod+e exec alacritty -e zsh -ic spf
# bindsym $mod+e exec nautilus
bindsym $mod+e exec --no-startup-id popup-toggle yazi-popup kitty --class yazi-popup yazi
bindsym $mod+Tab focus mode_toggle
# Launch Firefox
bindsym $mod+Shift+f exec --no-startup-id firefox
# Zathura for documentation
bindsym $mod+Shift+z exec --no-startup-id zathura
# Close focused window
bindsym $mod+q kill
# Power menu
bindsym $mod+x exec --no-startup-id power-menu
# Launch menu (rofi)
bindsym $mod+space exec --no-startup-id menu-launcher
# bindsym $mod+space exec menu-launcher
# Clipboard history
bindsym $mod+v exec --no-startup-id float-term clipboard-history clipboard-history
bindsym $mod+Shift+v exec --no-startup-id clipboard-clear
# Reload i3 config
bindsym $mod+Shift+r reload
# Key shortcut reference
bindsym $mod+i exec --no-startup-id ~/.config/i3/show-keyshortcuts.sh
# Notifications
bindsym $mod+Shift+n exec --no-startup-id system-control dnd
# Screenshots
bindsym F8 exec --no-startup-id ~/.config/i3/fkeys-media.sh F8 screenshot region
bindsym Shift+F8 exec --no-startup-id screenshot full
bindsym Ctrl+F8 exec --no-startup-id screenshot copy
# popup/menu grabs keyboard so F8 is dead while open: press this, then open the popup within 3s
bindsym $mod+F8 exec --no-startup-id screenshot full 3
# Toggle 4000K night light
bindsym F9 exec --no-startup-id ~/.config/i3/fkeys-media.sh F9 system-control night-light
# Wallpaper picker
bindsym $mod+p exec --no-startup-id wallpaper-menu
# Display management
bindsym $mod+Shift+m exec --no-startup-id display-menu
# Audio output picker
bindsym $mod+Shift+o exec --no-startup-id audio-menu
# Task manager popup
bindsym Ctrl+Shift+Escape exec --no-startup-id float-term htop htop
# Wi-Fi / Bluetooth (own class: escapes the alacritty -> workspace 1 rule, floats)
bindsym $mod+w exec --no-startup-id float-term wifitui wifitui
bindsym $mod+Shift+w exec --no-startup-id float-term bluetui bluetui
for_window [class="^(wifitui|bluetui|htop|pavucontrol|pomodoro-task|lofi-player|clipboard-history|yazi-popup)$"] floating enable, resize set 960 600, move position center
# Sized in cells by float-term --size (fits the calendar on any monitor DPI)
for_window [class="^lunar-calendar$"] floating enable, move position center
# Lofi track picker
bindsym $mod+m exec --no-startup-id float-term lofi-player lofi-player
# Lofi repeat current track on/off
bindsym $mod+Ctrl+m exec --no-startup-id lofi loop
# Pomodoro task list
bindsym $mod+t exec --no-startup-id float-term pomodoro-task pomodoro-task
# Lunar calendar (same as clicking the bar clock)
bindsym $mod+c exec --no-startup-id float-term --size 46x23 lunar-calendar lunar-calendar
# Grayscale filter toggle (picom shader)
bindsym $mod+Ctrl+c exec --no-startup-id grayscale-toggle

# exec --no-startup-id feh --bg-fill --no-fehbg ~/dot-ccin/Wallpapers/catppuccin-abstract-eclipse-1920x1080.png
exec --no-startup-id feh --bg-fill --no-fehbg "$(cat ~/.wallpaper 2>/dev/null || echo ~/dot-ccin/Wallpapers/wallpaper.png)"

default_orientation horizontal

# Move focus between windows
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# Move window instead of just focusing
bindsym $mod+Shift+h move left
bindsym $mod+Shift+l move right
bindsym $mod+Shift+k move up
bindsym $mod+Shift+j move down

# resise window
bindsym $mod+Ctrl+h resize shrink width 10px
bindsym $mod+Ctrl+l resize grow width 10px
bindsym $mod+Ctrl+k resize grow height 10px
bindsym $mod+Ctrl+j resize shrink height 10px


# Split layout 70/30
bindsym $mod+o splitv; resize set height 70 ppt
bindsym $mod+u splith; resize set width 70 ppt

# Shrink windows on current workspace to show wallpaper (toggle)
bindsym $mod+g gaps outer current toggle 60

# Brightness
# Increase brightness
bindsym XF86MonBrightnessUp exec --no-startup-id system-control brightness-up
# Decrease brightness
bindsym XF86MonBrightnessDown exec --no-startup-id system-control brightness-down
# Volume
bindsym XF86AudioRaiseVolume exec --no-startup-id system-control volume-up
bindsym XF86AudioLowerVolume exec --no-startup-id system-control volume-down
bindsym XF86AudioMute exec --no-startup-id system-control volume-mute
# Function-key media controls
bindsym F1 exec --no-startup-id ~/.config/i3/fkeys-media.sh F1 system-control volume-mute
bindsym F2 exec --no-startup-id ~/.config/i3/fkeys-media.sh F2 system-control volume-down
bindsym F3 exec --no-startup-id ~/.config/i3/fkeys-media.sh F3 system-control volume-up
bindsym F6 exec --no-startup-id ~/.config/i3/fkeys-media.sh F6 system-control brightness-set 5
bindsym F7 exec --no-startup-id ~/.config/i3/fkeys-media.sh F7 system-control brightness-set 80
# Toggle F-key media functions on/off (F1-F3, F6-F9 pass through when off)
bindsym $mod+F1 exec --no-startup-id ~/.config/i3/fkeys-toggle.sh
# Caps Lock status
bindsym --release Caps_Lock exec --no-startup-id system-control caps-lock

# Workspace
# Open it while starting up
exec --no-startup-id i3-msg workspace 1
default_border pixel 3
gaps inner 2
focus_follows_mouse no
# Mouse: Mod+left drag moves; Mod+right drag resizes tiled or floating (i3 native)
floating_modifier $mod
tiling_drag modifier titlebar
# Focus
client.focused          #b4befe #1e1e2e #cdd6f4 #b4befe #b4befe
# Không focus
client.unfocused        #585b70 #1e1e2e #a6adc8 #585b70 #585b70
client.focused_inactive #585b70 #1e1e2e #a6adc8 #585b70 #585b70
# Urgent
client.urgent           #f38ba8 #1e1e2e #f38ba8 #f38ba8 #f38ba8
client.background       #1e1e2e
bar {
  position top
  height 34
  # mode hide
  # pixel font: only 11px/22px land on its grid (pt sizes blur)
  font pango:DepartureMono Nerd Font 18px
  padding 0 4px
  workspace_min_width 28
  tray_padding 2
  # touch: watch_files needs ~/.cache/pomodoro-tasks to exist or the task block errors
  status_command sh -c 'touch -a ~/.cache/pomodoro-tasks; exec i3status-rs ~/.config/i3status-rust/config.toml'

  colors {
    background         #11111b
    statusline         #cdd6f4
    separator          #45475a

    # target           border  bg      text
    focused_workspace  #cba6f7 #cba6f7 #11111b
    active_workspace   #45475a #45475a #cdd6f4
    inactive_workspace #11111b #11111b #7f849c
    urgent_workspace   #f38ba8 #f38ba8 #11111b
    binding_mode       #fab387 #fab387 #11111b
  }
}

bindsym $mod+Shift+t bar mode toggle
# Workspaces define
# any
bindsym $mod+a workspace A
# documents
bindsym $mod+d workspace D
# browser
bindsym $mod+b workspace B

bindsym $mod+1 workspace 1
bindsym $mod+2 workspace 2
bindsym $mod+3 workspace 3
bindsym $mod+4 workspace 4
bindsym $mod+5 workspace 5

# Cycle through active workspaces
bindsym $mod+Left workspace prev
bindsym $mod+Right workspace next

# Workspaces moving
bindsym $mod+Shift+a move container to workspace A
bindsym $mod+Shift+d move container to workspace D
bindsym $mod+Shift+b move container to workspace B
bindsym $mod+Shift+1 move container to workspace 1
bindsym $mod+Shift+2 move container to workspace 2
bindsym $mod+Shift+3 move container to workspace 3
bindsym $mod+Shift+4 move container to workspace 4
bindsym $mod+Shift+5 move container to workspace 5
# Which app is assigned to which workspace
assign [class="(?i)firefox"] B
assign [class="(?i)zathura"] D
assign [class="(?i)alacritty"] workspace 1
assign [class="(?i)zalo"] workspace 3
assign [class="(?i)discord"] workspace 3
assign [class="(?i)localsend"] workspace 2
assign [class="(?i)omniget"] workspace 2
assign [class="(?i)nautilus"] workspace 2
assign [class="(?i)thunar"] workspace 2
assign [class="(?i)ytdownloader"] workspace 2
assign [class="(?i)qbittorrent"] workspace 2
assign [class="(?i)matlab"] workspace 3
for_window [class="(?i)firefox"] workspace B
for_window [class="(?i)zathura"] workspace D
for_window [class="(?i)alacritty"] workspace 1
for_window [class="(?i)zalo"] workspace 3
for_window [class="(?i)discord"] workspace 3
for_window [class="(?i)localsend"] workspace 2
for_window [class="(?i)omniget"] workspace 2
for_window [class="(?i)nautilus"] workspace 2
for_window [class="(?i)thunar"] workspace 2
for_window [class="(?i)ytdownloader"] workspace 2
for_window [class="(?i)qbittorrent"] workspace 2
for_window [class="(?i)matlab"] workspace 3
