{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "file",
        "source": "~/dot-ccin/dotfiles/fastfetch/images/sleepcat.txt",
        "color": {
            "1": "#f5e0dc"
        }
    },

    "display": {
        "separator": "  "
    },

    "modules": [
        "break",

        {
            "type": "title",
            "color": {
                "user": "#b48ead",
                "at": "#b48ead",
                "host": "#d8dee9"
            }
        },

        {
            "type": "os",
            "key": "os",
            "keyColor": "#b48ead"
        },

        {
            "type": "host",
            "key": "host",
            "keyColor": "#b48ead"
        },

        {
            "type": "kernel",
            "key": "kernel",
            "keyColor": "#b48ead"
        },

        {
            "type": "uptime",
            "key": "uptime",
            "keyColor": "#b48ead"
        },

        {
            "type": "packages",
            "key": "pkgs",
            "keyColor": "#b48ead"
        },

        {
            "type": "memory",
            "key": "memory",
            "keyColor": "#b48ead"
        },

        "break"
    ]
}
